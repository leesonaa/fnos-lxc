#!/bin/bash
# wizard/uninstall 的 keep_data 开关以 wizard_keep_data 传入
# 兼容 true/false、1/0、on/off、yes/no（大小写不敏感）
DATA_DIR="${TRIM_PKGVAR:-/vol1/@appdata/fnos-lxc}"

log() { echo "[fnos-lxc uninstall] $*" ; }

# 取初始化时用户选择的容器存储路径（config.json 的 lxcpath），没有则用 lxc 当前配置
get_lxcpath() {
  local p=""
  if [ -f "${DATA_DIR}/config.json" ] && command -v python3 >/dev/null 2>&1; then
    p="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get("lxcpath") or "")' "${DATA_DIR}/config.json" 2>/dev/null)"
  fi
  [ -z "$p" ] && command -v lxc-config >/dev/null 2>&1 && p="$(lxc-config lxc.lxcpath 2>/dev/null)"
  # 再兜底读 /etc/lxc/lxc.conf
  if [ -z "$p" ] && [ -f /etc/lxc/lxc.conf ]; then
    p="$(sed -n 's/^[[:space:]]*lxc\.lxcpath[[:space:]]*=[[:space:]]*//p' /etc/lxc/lxc.conf 2>/dev/null | head -1)"
  fi
  echo "${p:-/var/lib/lxc}"
}

# 与初始化时 check_lxcpath 的规则一致：绝对路径、至少两级、不在系统目录下，绝不删 /vol1、/ 等
safe_to_remove() {
  local p="${1%/}"
  case "$p" in /*) ;; *) return 1 ;; esac
  case "$p" in *..*|*[[:cntrl:]]*) return 1 ;; esac
  [ "$(echo "$p" | tr -cd / | wc -c)" -ge 2 ] || return 1
  local d
  for d in /etc /usr /bin /sbin /lib /lib64 /boot /proc /sys /dev /run /root /var /home; do
    case "$p" in "$d"|"$d"/*) return 1 ;; esac
  done
  return 0
}

# 判断「不要保留数据」：多种假值都算
keep_raw="${wizard_keep_data:-true}"
keep_lc="$(printf '%s' "$keep_raw" | tr '[:upper:]' '[:lower:]')"
do_purge=0
case "$keep_lc" in
  false|0|off|no|n) do_purge=1 ;;
esac

log "wizard_keep_data=[${keep_raw}] do_purge=${do_purge} DATA_DIR=${DATA_DIR}"

if [ "$do_purge" = "1" ]; then
  LXCPATH="$(get_lxcpath)"
  LXCPATH="${LXCPATH%/}"
  log "LXCPATH=${LXCPATH}"

  # 1) 停止并销毁该存储路径下的全部容器
  if command -v lxc-ls >/dev/null 2>&1 && [ -d "$LXCPATH" ]; then
    for n in $(lxc-ls -P "$LXCPATH" -1 2>/dev/null); do
      log "stop+destroy container: $n"
      lxc-stop -P "$LXCPATH" -n "$n" -k 2>/dev/null || true
      # 再等一下，尽量卸掉挂载
      sleep 1
      lxc-destroy -P "$LXCPATH" -n "$n" -f -s 2>/dev/null || true
    done
  else
    log "skip container destroy (no lxc-ls or dir missing)"
  fi

  # 2) 还原初始化时备份的宿主机 LXC 配置
  for f in lxc.conf default.conf; do
    if [ -f "${DATA_DIR}/orig/${f}" ]; then
      log "restore /etc/lxc/${f}"
      cp -f "${DATA_DIR}/orig/${f}" "/etc/lxc/${f}" 2>/dev/null || true
    fi
  done

  # 3) 尽量卸掉残留挂载后再删目录
  if [ -d "$LXCPATH" ]; then
    if ! safe_to_remove "$LXCPATH"; then
      log "skip removing storage dir (unsafe path): $LXCPATH"
    else
      # 尝试卸载仍挂在该路径下的挂载点（从深到浅）
      if command -v findmnt >/dev/null 2>&1; then
        findmnt -rn -o TARGET | grep -F "${LXCPATH}/" | sort -r | while read -r mnt; do
          log "umount residual: $mnt"
          umount -l "$mnt" 2>/dev/null || true
        done
      else
        # 无 findmnt 时用 /proc/mounts
        awk -v p="${LXCPATH}/" '$2 ~ "^"p {print $2}' /proc/mounts | sort -r | while read -r mnt; do
          log "umount residual: $mnt"
          umount -l "$mnt" 2>/dev/null || true
        done
      fi
      sleep 1

      if grep -qs " ${LXCPATH}/" /proc/mounts || grep -qs " ${LXCPATH} " /proc/mounts; then
        log "skip removing storage dir (still mounted): $LXCPATH"
        grep " ${LXCPATH}" /proc/mounts || true
      else
        for l in /var/lib/lxc /var/cache/lxc; do
          if [ -L "$l" ]; then
            t="$(readlink -f "$l" 2>/dev/null)"
            case "$t" in "$LXCPATH"|"$LXCPATH"/*)
              log "remove symlink $l -> $t"
              rm -f "$l"
              ;;
            esac
          fi
        done
        log "rm -rf $LXCPATH"
        rm -rf --one-file-system "$LXCPATH" 2>/dev/null || true
        [ -d "$LXCPATH" ] && log "warning: failed to fully remove $LXCPATH"
      fi
    fi
  fi

  log "rm -rf DATA_DIR ${DATA_DIR}"
  rm -rf "${DATA_DIR}" 2>/dev/null || true
else
  log "keep_data enabled, skip purge of containers and storage"
fi

echo "fnos-lxc uninstall_callback ok"
exit 0
