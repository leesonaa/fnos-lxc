#!/bin/bash
# fnos-lxc service control

APP_NAME="fnos-lxc"
APP_DIR="${TRIM_APPDEST:-/var/apps/${APP_NAME}/target}"
DATA_DIR="${TRIM_PKGVAR:-/vol1/@appdata/${APP_NAME}}"
PID_FILE="${DATA_DIR}/server.pid"
LOG_FILE="${DATA_DIR}/server.log"
SERVER="${APP_DIR}/server/main.py"
SOCK="${APP_DIR}/app.sock"

mkdir -p "${DATA_DIR}"

# PID 文件在数据卷上，重启后可能残留，PID 又可能被别的进程复用：必须核对命令行
is_ours() {
  [ -n "$1" ] && [ -r "/proc/$1/cmdline" ] && tr '\0' ' ' < "/proc/$1/cmdline" | grep -qF "${SERVER}"
}

start() {
  if [ -f "${PID_FILE}" ] && is_ours "$(cat "${PID_FILE}")"; then
    echo "${APP_NAME} already running"
    return 0
  fi
  rm -f "${PID_FILE}"
  cd "${APP_DIR}/server"
  if ! command -v python3 >/dev/null 2>&1; then
    echo "python3 not found" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
    return 1
  fi
  nohup python3 "${SERVER}" --socket "${SOCK}" --data-dir "${DATA_DIR}" >> "${LOG_FILE}" 2>&1 &
  echo $! > "${PID_FILE}"
  sleep 1
  if ! is_ours "$(cat "${PID_FILE}")"; then
    tail -n 20 "${LOG_FILE}" >> "${TRIM_TEMP_LOGFILE:-/dev/stderr}" 2>/dev/null
    rm -f "${PID_FILE}"
    return 1
  fi
  echo "started ${APP_NAME} pid=$(cat ${PID_FILE})"
}

stop() {
  if [ -f "${PID_FILE}" ]; then
    PID=$(cat "${PID_FILE}")
    if is_ours "${PID}"; then
      kill "${PID}" 2>/dev/null || true
      sleep 1
      kill -9 "${PID}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}"
  fi
  rm -f "${SOCK}"
  # fallback
  pkill -f "python3 .*${APP_NAME}/.*main.py" 2>/dev/null || true
  echo "stopped ${APP_NAME}"
}

status() {
  if [ -f "${PID_FILE}" ] && is_ours "$(cat "${PID_FILE}")"; then
    exit 0
  fi
  exit 3
}

case "$1" in
  start) start || exit 1 ;;
  stop) stop ;;
  restart) stop; start || exit 1 ;;
  status) status ;;
  *) exit 1 ;;
esac
